cdlib/models/vendor/bit/networks.py
cdlib/models/vendor/bit/resnet.py
cdlib/models/vendor/bit/help_funcs.py

# Large artifacts (datasets, downloaded weights, checkpoints)
data/*
!data/.gitkeep
weights/*
!weights/.gitkeep
outputs/checkpoints/*

# Third-party repos cloned for reference
third_party/
outputs/checks/
outputs/predictions/
