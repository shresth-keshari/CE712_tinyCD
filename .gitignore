# Environment
.venv/
.venv_win/
.tools/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/

# Regenerable large inference outputs (results/ and assets/demo/ are intended for version control)
outputs/new/
# USGS originals are covered by data/*; prepared pairs are local until reviewed for inclusion.
